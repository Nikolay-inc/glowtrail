{
  "name": "glowtrail",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "vite-node scripts/verify.ts",
    "ease": "vite-node scripts/ease.ts",
    "gen": "vite-node scripts/gen.ts --",
    "pick": "vite-node scripts/pick.ts --",
    "build:app": "npm run version:bump && tsc --noEmit && vite build --mode app",
    "cap:sync": "npm run build:app && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "icons": "vite-node scripts/make-icons.ts && capacitor-assets generate --ios --android --iconBackgroundColor '#0b0f27' --splashBackgroundColor '#0b0f27'",
    "sim-economy": "vite-node scripts/sim-economy.ts",
    "version:bump": "vite-node scripts/app-version.ts",
    "ios:check": "vite-node scripts/ios-check.ts",
    "ios:strings": "vite-node scripts/ios-strings.ts",
    "i18n-check": "vite-node scripts/i18n-check.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/admob": "7.2.0",
    "@capacitor-firebase/analytics": "7.5.0",
    "@capacitor-firebase/remote-config": "7.5.0",
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/ios": "7.6.10",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@revenuecat/purchases-capacitor": "11.3.3",
    "@sentry/browser": "10.76.2",
    "@sentry/capacitor": "4.6.0",
    "@supabase/supabase-js": "2.118.0",
    "firebase": "11.10.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.10",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-armenian": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@sentry/vite-plugin": "11.19.0",
    "@types/node": "^20.19.43",
    "patch-package": "8.0.1",
    "playwright": "1.65.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
