+    /**
+     * Glowtrail (patch-package): IAB TCF v2 строки, которые форма UMP пишет в UserDefaults.
+     * purposeConsents — «0101…», символ i-1 — согласие на цель i; gdprApplies — 1, если действует GDPR.
+     */
+    @objc func getTcfConsent(_ call: CAPPluginCall) {
+        let d = UserDefaults.standard
+        let applies = d.object(forKey: "IABTCF_gdprApplies")
+        var gdpr = -1
+        if let n = applies as? NSNumber { gdpr = n.intValue } else if let s = applies as? String, let n = Int(s) { gdpr = n }
+        call.resolve([
+            "purposeConsents": d.string(forKey: "IABTCF_PurposeConsents") ?? "",
+            "gdprApplies": gdpr
+        ])
+    }
