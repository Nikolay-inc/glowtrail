# Supabase — публичные значения проекта (Project Settings → API).
# anon-ключ можно хранить в коде: доступ к данным защищён политиками RLS в базе.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Адрес для «Отправить отзыв» и контакта в политике конфиденциальности: впиши в .env.local (не коммитится);
# для сайта — секрет репозитория VITE_CONTACT_EMAIL (Settings → Secrets and variables → Actions)
VITE_CONTACT_EMAIL=
