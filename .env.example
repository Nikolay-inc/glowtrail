# Supabase — публичные значения проекта (Project Settings → API).
# anon-ключ можно хранить в коде: доступ к данным защищён политиками RLS в базе.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Адрес для «Отправить отзыв» и контакта в политике конфиденциальности: впиши в .env.local (не коммитится);
# для сайта — секрет репозитория VITE_CONTACT_EMAIL (Settings → Secrets and variables → Actions)
VITE_CONTACT_EMAIL=

# --- Аналитика и ошибки (Р5). Без этих значений Firebase и Sentry выключены, игра работает как раньше. ---
# Firebase, веб-приложение (Project settings → Your apps → Web app → SDK setup → Config). Значения публичные —
# их можно хранить в .env.production (сайт) и .env.app (приложение), как ключи Supabase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# В приложении Firebase берёт настройки из файлов (в git не идут):
#   ios/App/App/GoogleService-Info.plist (перетащить в Xcode в цель App), android/app/google-services.json

# Sentry: DSN публичный (Project settings → Client Keys) — в .env.production и .env.app.
VITE_SENTRY_DSN=
# Загрузка source maps при сборке: организация и проект (не секрет) — в .env.production / .env.app,
# токен (секрет! Settings → Auth Tokens, scope project:releases) — только в .env.local и в секрет репозитория.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Реклама и покупки (Р4). Без этих значений — тестовый режим: тестовые ролики Google и тестовый магазин. ---
# AdMob: тестовый режим выключается только явно (VITE_ADMOB_TEST=0), тогда нужны боевые ID блоков (Ad units).
# ID приложения AdMob — не здесь, а в ios/App/App/Info.plist (GADApplicationIdentifier) и AndroidManifest (APPLICATION_ID).
VITE_ADMOB_TEST=
VITE_ADMOB_IOS_REWARDED=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=
VITE_ADMOB_ANDROID_INTERSTITIAL=
# RevenueCat: публичные ключи SDK (Project settings → API keys → appl_… / goog_…, или test_… для Test Store) — в .env.app.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
